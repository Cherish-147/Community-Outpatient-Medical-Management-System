<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 社区门诊医务管理系统</title>

    <!-- 第三方样式库 -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- 项目自定义样式 -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/COMMSMVC.styles.css" asp-append-version="true" />

    <!-- 布局专用样式文件（核心抽离的样式） -->
    <link rel="stylesheet" href="~/css/_Layout.css" asp-append-version="true" />
</head>
<body>
    <!-- 顶部导航栏 -->
    <nav class="navbar navbar-expand-lg top-nav">
        <div class="container-fluid">
            <!-- 移动端侧边栏切换按钮 -->
            <button class="btn btn-outline-primary me-2 d-lg-none" id="sidebarToggle">
                <i class="bi bi-list"></i>
            </button>

            <!-- 系统名称 -->
            <a class="navbar-brand fw-bold text-primary" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-hospital"></i> 社区门诊医务管理系统
            </a>

            <!-- 右侧用户信息区域 -->
            <div class="d-flex align-items-center">
                @if (string.IsNullOrEmpty(Context.Session.GetString("JwtToken")) || string.IsNullOrEmpty(Context.Session.GetString("UserID")))
                {
                    <!-- 未登录状态 -->
                    <a class="nav-link text-secondary me-2" asp-controller="Home" asp-action="Login">
                        <i class="bi bi-box-arrow-in-right"></i> 登录
                    </a>
                    <a class="nav-link text-secondary" asp-controller="Home" asp-action="Register">
                        <i class="bi bi-person-plus"></i> 注册
                    </a>
                }
                else
                {
                    <!-- 已登录状态 -->
                    <span class="text-success me-3">
                        <i class="bi bi-person"></i> @Context.Session.GetString("Username")
                    </span>
                    <a class="nav-link text-secondary me-2" asp-controller="Patient" asp-action="PatientIndex">
                        <i class="bi bi-person-circle"></i> 患者中心
                    </a>
                    <a class="nav-link text-danger" asp-controller="Home" asp-action="Logout">
                        <i class="bi bi-box-arrow-right"></i> 退出
                    </a>
                }
            </div>
        </div>
    </nav>

    <!-- 侧边导航栏 -->
    <div class="sidebar" id="sidebar">
        <ul class="nav flex-column">
            <!-- 首页 -->
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "Index" && ViewContext.RouteData.Values["Controller"].ToString() == "Home" ? "active" : "")"
                   asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-house-door me-2"></i> 系统首页
                </a>
            </li>

            <!-- 已登录用户显示对应菜单 -->
            @if (!string.IsNullOrEmpty(Context.Session.GetString("JwtToken")) && !string.IsNullOrEmpty(Context.Session.GetString("UserID")))
            {
                <!-- 判断用户角色：患者（可根据实际角色字段调整，示例用UserType区分） -->
                @if (Context.Session.GetString("Role") == "Patient")
                {
                    <!-- 患者专属菜单 -->
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "PatientIndex" && ViewContext.RouteData.Values["Controller"].ToString() == "Patient" ? "active" : "")"
                           asp-controller="Patient" asp-action="PatientIndex">
                            <i class="bi bi-person-heart me-2"></i> 患者中心
                        </a>
                    </li>

                    <!-- 患者核心功能菜单 -->
                    <li class="nav-item">
                        <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["Controller"].ToString() == "Patient" && ViewContext.RouteData.Values["Action"].ToString() != "PatientIndex" ? "active" : "")"
                           href="#" role="button" data-bs-toggle="collapse" data-bs-target="#patientFunctionMenu" aria-expanded="false">
                            <i class="bi bi-clipboard2-check me-2"></i> 我的就医
                        </a>
                        <div class="collapse @(ViewContext.RouteData.Values["Controller"].ToString() == "Patient" && ViewContext.RouteData.Values["Action"].ToString() != "PatientIndex" ? "show" : "")" id="patientFunctionMenu">
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item @(ViewContext.RouteData.Values["Action"].ToString() == "RegisterAppointment" ? "active" : "")" asp-controller="Patient" asp-action="RegisterAppointment">预约挂号</a></li>
                                <li><a class="dropdown-item @(ViewContext.RouteData.Values["Action"].ToString() == "MyRecords" ? "active" : "")" asp-controller="Patient" asp-action="MyRecords">我的病历</a></li>
                                <li><a class="dropdown-item @(ViewContext.RouteData.Values["Action"].ToString() == "MyPrescriptions" ? "active" : "")" asp-controller="Patient" asp-action="MyPrescriptions">我的处方</a></li>
                                <li><a class="dropdown-item @(ViewContext.RouteData.Values["Action"].ToString() == "MyPayments" ? "active" : "")" asp-controller="Patient" asp-action="MyPayments">缴费记录</a></li>
                                <li><a class="dropdown-item @(ViewContext.RouteData.Values["Action"].ToString() == "EditProfile" ? "active" : "")" asp-controller="Patient" asp-action="EditProfile">个人信息</a></li>
                                <li><a class="dropdown-item @(ViewContext.RouteData.Values["Action"].ToString() == "BookDoctor" ? "active" : "")" asp-controller="Patient" asp-action="BookDoctor">常用医生</a></li>
                            </ul>
                        </div>
                    </li>
                }
                else
                {
                    <!-- 管理员/医护人员菜单（原有菜单保留） -->
                    <!-- 挂号管理 -->
                    <li class="nav-item">
                        <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["Controller"].ToString() == "Registration" ? "active" : "")"
                           href="#" role="button" data-bs-toggle="collapse" data-bs-target="#registrationMenu" aria-expanded="false">
                            <i class="bi bi-journal-medical me-2"></i> 挂号管理
                        </a>
                        <div class="collapse @(ViewContext.RouteData.Values["Controller"].ToString() == "Registration" ? "show" : "")" id="registrationMenu">
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Registration" asp-action="Index">挂号列表</a></li>
                                <li><a class="dropdown-item" asp-controller="Registration" asp-action="Create">新增挂号</a></li>
                                <li><a class="dropdown-item" asp-controller="Registration" asp-action="Statistics">挂号统计</a></li>
                            </ul>
                        </div>
                    </li>

                    <!-- 患者管理 -->
                    <li class="nav-item">
                        <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["Controller"].ToString() == "Patient" ? "active" : "")"
                           href="#" role="button" data-bs-toggle="collapse" data-bs-target="#patientMenu" aria-expanded="false">
                            <i class="bi bi-person-heart me-2"></i> 患者管理
                        </a>
                        <div class="collapse @(ViewContext.RouteData.Values["Controller"].ToString() == "Patient" ? "show" : "")" id="patientMenu">
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Patient" asp-action="Index">患者列表</a></li>
                                <li><a class="dropdown-item" asp-controller="Patient" asp-action="Create">新增患者</a></li>
                                <li><a class="dropdown-item" asp-controller="Patient" asp-action="MedicalRecord">病历档案</a></li>
                                <li><a class="dropdown-item" asp-controller="Patient" asp-action="FollowUp">随访记录</a></li>
                            </ul>
                        </div>
                    </li>

                    <!-- 医生管理 -->
                    <li class="nav-item">
                        <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["Controller"].ToString() == "Doctor" ? "active" : "")"
                           href="#" role="button" data-bs-toggle="collapse" data-bs-target="#doctorMenu" aria-expanded="false">
                            <i class="bi bi-person-badge me-2"></i> 医生管理
                        </a>
                        <div class="collapse @(ViewContext.RouteData.Values["Controller"].ToString() == "Doctor" ? "show" : "")" id="doctorMenu">
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Doctor" asp-action="Index">医生列表</a></li>
                                <li><a class="dropdown-item" asp-controller="Doctor" asp-action="Create">新增医生</a></li>
                                <li><a class="dropdown-item" asp-controller="Doctor" asp-action="Schedule">出诊安排</a></li>
                            </ul>
                        </div>
                    </li>

                    <!-- 药品管理 -->
                    <li class="nav-item">
                        <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["Controller"].ToString() == "Medicine" ? "active" : "")"
                           href="#" role="button" data-bs-toggle="collapse" data-bs-target="#medicineMenu" aria-expanded="false">
                            <i class="bi bi-pills me-2"></i> 药品管理
                        </a>
                        <div class="collapse @(ViewContext.RouteData.Values["Controller"].ToString() == "Medicine" ? "show" : "")" id="medicineMenu">
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Medicine" asp-action="Index">药品库存</a></li>
                                <li><a class="dropdown-item" asp-controller="Medicine" asp-action="Purchase">药品采购</a></li>
                                <li><a class="dropdown-item" asp-controller="Medicine" asp-action="Expiry">效期提醒</a></li>
                            </ul>
                        </div>
                    </li>

                    <!-- 收费管理 -->
                    <li class="nav-item">
                        <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["Controller"].ToString() == "Payment" ? "active" : "")"
                           href="#" role="button" data-bs-toggle="collapse" data-bs-target="#paymentMenu" aria-expanded="false">
                            <i class="bi bi-cash-stack me-2"></i> 收费管理
                        </a>
                        <div class="collapse @(ViewContext.RouteData.Values["Controller"].ToString() == "Payment" ? "show" : "")" id="paymentMenu">
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Payment" asp-action="Index">收费记录</a></li>
                                <li><a class="dropdown-item" asp-controller="Payment" asp-action="Create">新增收费</a></li>
                                <li><a class="dropdown-item" asp-controller="Payment" asp-action="Refund">退费处理</a></li>
                            </ul>
                        </div>
                    </li>

                    <!-- 系统管理 -->
                    <li class="nav-item">
                        <a class="nav-link dropdown-toggle @(ViewContext.RouteData.Values["Controller"].ToString() == "System" ? "active" : "")"
                           href="#" role="button" data-bs-toggle="collapse" data-bs-target="#systemMenu" aria-expanded="false">
                            <i class="bi bi-gear me-2"></i> 系统管理
                        </a>
                        <div class="collapse @(ViewContext.RouteData.Values["Controller"].ToString() == "System" ? "show" : "")" id="systemMenu">
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="System" asp-action="UserManagement">用户管理</a></li>
                                <li><a class="dropdown-item" asp-controller="System" asp-action="RoleManagement">角色权限</a></li>
                                <li><a class="dropdown-item" asp-controller="System" asp-action="Parameter">系统参数</a></li>
                                <li><a class="dropdown-item" asp-controller="System" asp-action="Log">操作日志</a></li>
                            </ul>
                        </div>
                    </li>

                    <!-- 数据统计 -->
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"].ToString() == "Statistics" ? "active" : "")"
                           asp-controller="Statistics" asp-action="Index">
                            <i class="bi bi-bar-chart me-2"></i> 数据统计
                        </a>
                    </li>
                }
            }

            <!-- 公共菜单：隐私政策 -->
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["Action"].ToString() == "Privacy" ? "active" : "")"
                   asp-area="" asp-controller="Home" asp-action="Privacy">
                    <i class="bi bi-shield-lock me-2"></i> 隐私政策
                </a>
            </li>
        </ul>
    </div>

    <!-- 主内容区域 -->
    <div class="main-content">
        <div class="container-fluid px-4">
            <!-- 页面提示信息 -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                    <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                    <i class="bi bi-exclamation-circle"></i> @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- 页面主体内容 -->
            <main role="main" class="pb-3">
                @RenderBody()
            </main>

            <!-- 页脚 -->
            <footer class="mt-auto">
                <div class="container-fluid">
                    <div class="row">
                        <div class="col-md-6">
                            &copy; @DateTime.Now.Year - 社区门诊医务管理系统 -
                            <a asp-area="" asp-controller="Home" asp-action="Privacy">隐私政策</a>
                        </div>
                        <div class="col-md-6 text-md-end">
                            <a href="#" class="text-muted">技术支持</a> |
                            <a href="#" class="text-muted">联系我们</a> |
                            <a href="#" class="text-muted">使用帮助</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- 脚本引用 -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- 侧边栏控制脚本 -->
    <script>
        // 移动端侧边栏切换逻辑
        document.addEventListener('DOMContentLoaded', function() {
            const sidebarToggle = document.getElementById('sidebarToggle');
            const sidebar = document.getElementById('sidebar');

            if (sidebarToggle && sidebar) {
                sidebarToggle.addEventListener('click', function() {
                    sidebar.classList.toggle('show');
                });
            }
        });
    </script>

    <!-- 项目自定义脚本 -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- 页面专属脚本区域 -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>