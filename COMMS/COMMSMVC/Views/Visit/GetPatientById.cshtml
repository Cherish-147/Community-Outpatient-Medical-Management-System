@model IEnumerable<COMMSMVC.Models.Patient>

@{
    ViewData["Title"] = "患者管理";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>患者信息管理</h1>

@* <p>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> 新增患者
    </a>
</p> *@

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-light">
            <tr>
                <th>患者ID</th>
                <th>用户ID</th>
                <th>姓名</th>
                <th>生日</th>
                <th>性别</th>
                <th>身份证号</th>
                <th>电话</th>
                <th>保险号</th>
                <th>创建时间</th>
                <th>更新时间</th>
                <th>婚姻状况</th>
                <th>民族</th>
                <th>工作单位</th>
                <th>职业</th>
                <th>地址</th>
                <th>既往病史</th>
                <th>药物过敏史</th>
                <th>监护人姓名</th>
                <th>监护人关系</th>
                <th>监护人地址</th>
                <th>监护人电话</th>
                <th>备注</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.PatientID</td>
                    <td>@item.UserId</td>
                    <td>@item.Name</td>
                    <td>@(item.Birthday?.ToString("yyyy-MM-dd") ?? "-")</td>
                    <td>
                        @switch (item.Gender)
                        {
                            case "M":
                                <span class="badge bg-primary">男</span>
                                break;
                            case "F":
                                <span class="badge bg-info">女</span>
                                break;
                            default:
                                <span class="badge bg-secondary">@item.Gender</span>
                                break;
                        }
                    </td>
                    <td>@item.IDCard</td>
                    <td>@item.Phone</td>
                    <td>@item.InsuranceNo</td>
                    <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@(item.UpdatedAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</td>
                    <td>
                        @(item.IsMarried.HasValue ? (item.IsMarried.Value ? "已婚" : "未婚") : "-")
                    </td>
                    <td>@(string.IsNullOrEmpty(item.Nation) ? "-" : item.Nation)</td>
                    <td>@(string.IsNullOrEmpty(item.WorkUnit) ? "-" : item.WorkUnit)</td>
                    <td>@(string.IsNullOrEmpty(item.Occupation) ? "-" : item.Occupation)</td>
                    <td>@(string.IsNullOrEmpty(item.Address) ? "-" : item.Address)</td>
                    <td>@(string.IsNullOrEmpty(item.PastMedicalHistory) ? "-" : item.PastMedicalHistory)</td>
                    <td>@(string.IsNullOrEmpty(item.DrugAllergyHistory) ? "-" : item.DrugAllergyHistory)</td>
                    <td>@(string.IsNullOrEmpty(item.GuardianName) ? "-" : item.GuardianName)</td>
                    <td>@(string.IsNullOrEmpty(item.GuardianRelationship) ? "-" : item.GuardianRelationship)</td>
                    <td>@(string.IsNullOrEmpty(item.GuardianAddress) ? "-" : item.GuardianAddress)</td>
                    <td>@(string.IsNullOrEmpty(item.GuardianPhone) ? "-" : item.GuardianPhone)</td>
                    <td>@(string.IsNullOrEmpty(item.Remark) ? "-" : item.Remark)</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.PatientID" class="btn btn-sm btn-outline-info" title="详情">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.PatientID" class="btn btn-sm btn-outline-warning" title="编辑">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.PatientID" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="删除"
                                    onclick="return confirm('确定要删除该患者信息吗？');">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script>
        // 可以在这里添加额外的JavaScript功能
    </script>
}



