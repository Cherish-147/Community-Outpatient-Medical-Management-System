@model IEnumerable<COMMSMVC.Models.AppointmentViewModel>

@{
    ViewData["Title"] = "就诊管理";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>就诊管理</h1>
<div>查看所有患者挂号</div>
<div>选择查看某个患者挂号</div>
<div>查看所有患者信息</div>
<div>查看某个患者信息</div>
<div>查看所有患者历史病历</div>
<div>查看某个患者历史病历</div>
<div>录入病历</div>
<div>录入某个患者病历</div>
<div>开检查单</div>
<div>开处方</div>
@*
<p>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> 新增就诊
    </a>
</p>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-light">
            <tr>
                <th>ID</th>
                <th>患者姓名</th>
                <th>排班ID</th>
                <th>状态</th>
                <th>预约时间</th>
                <th>备注</th>
                <th>操作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.AppointmentID</td>
                    <td>@item.PatientName</td>
                    <td>@item.ScheduleID</td>
                    <td>
                        @{
                            // 根据状态设置不同的徽章样式
                            string badgeClass = item.Status switch
                            {
                                "已预约" => "bg-primary",
                                "已到诊" => "bg-info",
                                "已看诊" => "bg-warning text-dark",
                                "已完成" => "bg-success",
                                "取消" or "已取消" => "bg-secondary",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @badgeClass">@item.Status</span>
                    </td>
                    <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@(string.IsNullOrEmpty(item.Remark) ? "-" : item.Remark)</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@item.AppointmentID" class="btn btn-sm btn-outline-info" title="详情">
                            <i class="bi bi-eye"></i>
                        </a>
                        <a asp-action="Edit" asp-route-id="@item.AppointmentID" class="btn btn-sm btn-outline-warning" title="编辑">
                            <i class="bi bi-pencil"></i>
                        </a>
                        <form asp-action="Delete" method="post" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.AppointmentID" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="删除"
                                    onclick="return confirm('确定要删除该就诊记录吗？');">
                                <i class="bi bi-trash"></i>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>*@